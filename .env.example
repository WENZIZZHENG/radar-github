# Radar 雷达环境变量模板：复制为 .env 后填实值（cp .env.example .env）。
# .env 被 .gitignore 排除、永不入仓；本模板只列键名与说明，不放任何真实值。
# 加载口径（app/config.py）：系统环境变量优先，.env 只补缺（setdefault 不覆盖）。

# GitHub 个人访问令牌（PAT），每日采集用——GraphQL nodes 批量 + Search。
# 只需公开数据只读权限（public_repo 足够）；缺失时采集任务在使用点报错，榜单页面不受影响。
GITHUB_TOKEN=

# ===== AI 提供方（OpenAI 兼容 chat/completions 协议；缺省 DeepSeek，换提供方只改本节变量） =====

# AI 总开关（可选，缺省 1 开）：本地开发置 0——不起真实 AI 调用、不烧额度，
# 搜索/翻译/推荐语/概要/候选词扫描全链路自动降级（榜单照常），与 key 缺失同一降级姿态。
# 生产千万不要置 0。
# AI_ENABLED=0

# AI API key：翻译 / 推荐理由 / AI 概要 / 智能搜索 / 候选词扫描。
# 缺失或 AI_ENABLED=0 时 AI 全链路自动降级（榜单照常出，无翻译/推荐语），不阻塞主流程。
AI_API_KEY=
# 兼容键（旧版键名，AI_API_KEY 未配置时回退读取；存量 .env 无需改名）：
# DEEPSEEK_API_KEY=

# 提供方端点与模型（可选，缺省 DeepSeek 官方）：换 OpenAI 兼容提供方时改这两个。
# AI_BASE_URL=https://api.deepseek.com/v1/chat/completions
# AI_MODEL=deepseek-chat

# AI 调用写死参数的缺省覆盖（可选，一般不配；非法值自动回落缺省）：
# AI_TIMEOUT_SECONDS=60        # 单次调用超时（秒）
# AI_MAX_RETRIES=1             # 失败重试次数（重试会放大额度消耗）
# AI_README_HEAD_CHARS=8000    # README 截断入 prompt 的字符上限——单次调用 token 成本主杠杆，降本可砍到 2000~3000

# SQLite 库路径（可选，缺省 <项目根>/data/radar.db）；生产为 /opt/radar/data/radar.db。
# RADAR_DB_PATH=

# 定时任务开关（可选，缺省开）：本地开发置 0 关掉进程内每日采集调度，避免起服务顺带打 API。
# 生产千万不要在 radar.service 里置 0（每日采集/周报都靠它）。
# RADAR_JOBS_ENABLED=0

# 服务器侧另有两个备份变量（BACKUP_DIR / BACKUP_REMOTE），不走 .env——
# cron 环境不读 .env，直接写在 crontab 里，见 scripts/backup.sh 头注释。
